generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// AUTENTICACAO
// ============================================

enum Role {
  CLINIC
  ADMIN
}

// Perfil do anunciante. Define que tipo de anuncio ele pode publicar e
// qual documento (CPF para medico, CNPJ para os demais).
enum AdvertiserType {
  MEDICO
  CLINICA
  EMPRESA
  COWORKING
  INSTITUICAO
}

enum DocumentType {
  CPF
  CNPJ
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  passwordHash           String    @map("password_hash")
  name                   String
  role                   Role      @default(CLINIC)
  // Quando preenchido, a conta está bloqueada pelo admin: não loga e não
  // cria/edita/publica anúncios. Nulável e aditivo (não afeta contas legadas).
  blockedAt              DateTime? @map("blocked_at")
  clinic                 Clinic?
  passwordResetTokens    PasswordResetToken[]
  acceptedTermsAt        DateTime? @map("accepted_terms_at")
  acceptedTermsVersion   String?   @map("accepted_terms_version")
  marketingOptIn         Boolean   @default(false) @map("marketing_opt_in")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

// Token de redefinição de senha. Guardamos apenas o HASH do token; o valor
// cru vai só no link enviado por e-mail. Expira e é de uso único.
model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

// ============================================
// CLINICA
// ============================================

model Clinic {
  id           String    @id @default(cuid())
  userId       String    @unique @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  // Tipo de anunciante. Default CLINICA para nao quebrar contas legadas,
  // que foram criadas antes da introducao dos tipos.
  advertiserType AdvertiserType @default(CLINICA) @map("advertiser_type")
  // Documento sem mascara (so digitos). Nulavel: contas legadas nao tem.
  document     String?
  documentType DocumentType? @map("document_type")
  phone        String?
  whatsapp     String
  city         String
  state        String   @default("")
  neighborhood String
  description  String?
  // Cliente correspondente no Asaas. Criado na primeira cobranca e reusado
  // nas seguintes, como a documentacao do gateway recomenda.
  asaasCustomerId String? @unique @map("asaas_customer_id")
  listings     Listing[]
  orders       PublicationOrder[]
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("clinics")
}

// ============================================
// ANUNCIO
// ============================================

enum ListingStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
  // Aprovado na moderacao, aguardando o pagamento da taxa de publicacao.
  AWAITING_PAYMENT
  // Vigencia paga terminou. Volta para PUBLISHED com um novo pedido pago.
  EXPIRED
}

enum ListingType {
  CLINIC
  EQUIPMENT
  EDUCATION
}

enum EquipmentCondition {
  NOVO
  SEMINOVO
  USADO
}

// Tipo da oportunidade educacional (usado quando Listing.type = EDUCATION)
enum EducationType {
  MENTORIA
  CURSO
  POS_GRADUACAO
  EVENTO
  OUTRO
}

enum EducationModality {
  PRESENCIAL
  ONLINE
  HIBRIDO
}

model Listing {
  id              String             @id @default(cuid())
  clinicId        String             @map("clinic_id")
  clinic          Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  type            ListingType        @default(CLINIC)
  title           String
  slug            String             @unique
  description     String             @db.VarChar(300)
  fullDescription String?            @map("full_description") @db.Text
  roomTypeId      String?            @map("room_type_id")
  roomType        RoomType?          @relation(fields: [roomTypeId], references: [id])
  city            String
  state           String             @default("")
  neighborhood    String
  whatsapp        String
  status          ListingStatus      @default(DRAFT)
  featured        Boolean            @default(false)
  reviewedAt      DateTime?          @map("reviewed_at")
  requiresRqe     Boolean            @default(false) @map("requires_rqe")
  // "Atende todas as especialidades": substitui a marcação individual — o
  // anúncio exibe uma badge única e casa com qualquer filtro de especialidade.
  allSpecialties  Boolean            @default(false) @map("all_specialties")
  // Motivo informado pelo admin ao rejeitar — exibido ao anunciante no painel.
  // Limpo quando o anúncio é aprovado/republicado.
  rejectionReason String?            @map("rejection_reason")

  // Free-text extra specialties that aren't in the taxonomy (clinic listings)
  customSpecialties String? @map("custom_specialties")

  // Free-text extra resources/amenities that aren't in the equipment taxonomy (clinic listings)
  customEquipment   String? @map("custom_equipment")

  // Equipment-only fields (type = EQUIPMENT)
  equipmentCategoryId String?            @map("equipment_category_id")
  equipmentCategory   EquipmentCategory? @relation(fields: [equipmentCategoryId], references: [id])
  brand               String?
  model               String?
  condition           EquipmentCondition?

  // Education-only fields (type = EDUCATION)
  educationType     EducationType?     @map("education_type")
  educationModality EducationModality? @map("education_modality")
  audience          String?            // "Para quem é indicado"
  workload          String?            // Carga horaria
  duration          String?            // Duracao / periodo
  investment        String?            // Investimento (texto livre: Gratuito / A combinar / valor)
  externalLink      String?            @map("external_link")

  // Fim da vigencia paga. Denormalizado do pedido vigente para o sweep de
  // expiracao e o painel serem uma consulta so; o pedido continua sendo a
  // fonte de verdade.
  paidUntil       DateTime?          @map("paid_until")

  images          ListingImage[]
  specialties     ListingSpecialty[]
  equipment       ListingEquipment[]
  events          ListingEvent[]
  dailyStats      ListingDailyStat[]
  orders          PublicationOrder[]
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([city])
  @@index([neighborhood])
  @@index([status])
  @@index([clinicId])
  @@index([type])
  @@map("listings")
}

// Categorias de aparelhos médicos (usado quando Listing.type = EQUIPMENT)
model EquipmentCategory {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  listings Listing[]

  @@map("equipment_categories")
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String   @map("listing_id")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
  isCover   Boolean  @default(false) @map("is_cover")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("listing_images")
}

// ============================================
// TAXONOMIAS (Lookup Tables)
// ============================================

model Specialty {
  id       String             @id @default(cuid())
  name     String             @unique
  slug     String             @unique
  listings ListingSpecialty[]

  @@map("specialties")
}

model Equipment {
  id       String             @id @default(cuid())
  name     String             @unique
  slug     String             @unique
  category String             @default("Estrutura")
  listings ListingEquipment[]

  @@map("equipment")
}

model RoomType {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  listings Listing[]

  @@map("room_types")
}

// ============================================
// TABELAS DE JUNCAO (N:N)
// ============================================

model ListingSpecialty {
  listingId   String    @map("listing_id")
  specialtyId String    @map("specialty_id")
  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([listingId, specialtyId])
  @@map("listing_specialties")
}

model ListingEquipment {
  listingId   String    @map("listing_id")
  equipmentId String    @map("equipment_id")
  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([listingId, equipmentId])
  @@map("listing_equipment")
}

// ============================================
// METRICAS POR ANUNCIO
// ============================================

enum ListingEventType {
  VIEW
  CONTACT
}

// Evento bruto de interesse em um anuncio. Existe por dois motivos: permitir a
// deduplicacao (o mesmo visitante recarregando a pagina nao infla o numero) e
// guardar o detalhe recente para auditoria. O historico longo vive no agregado
// diario, entao estas linhas podem ser podadas sem perder o numero.
//
// LGPD: `visitorHash` e um hash com sal de IP + user-agent + dia. Nao guardamos
// IP nem user-agent em texto, e o hash muda a cada dia, entao nao permite
// acompanhar a mesma pessoa ao longo do tempo.
model ListingEvent {
  id          String           @id @default(cuid())
  listingId   String           @map("listing_id")
  listing     Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  type        ListingEventType
  visitorHash String           @map("visitor_hash")
  // listingId:type:visitorHash:AAAA-MM-DD — a unicidade e o que faz a deduplicacao.
  dedupeKey   String           @unique @map("dedupe_key")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([listingId, createdAt])
  @@index([createdAt])
  @@map("listing_events")
}

// Consolidacao por anuncio e por dia. E daqui que o painel do anunciante le,
// para nao varrer eventos brutos a cada consulta e para manter o historico
// mes a mes mesmo depois da poda dos eventos.
model ListingDailyStat {
  listingId String   @map("listing_id")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  // Meia-noite no fuso de Brasilia, normalizada em UTC no momento da gravacao.
  day       DateTime @db.Date
  views     Int      @default(0)
  contacts  Int      @default(0)

  @@id([listingId, day])
  @@index([day])
  @@map("listing_daily_stats")
}

// ============================================
// COBRANCA POR PUBLICACAO
// ============================================

enum PublicationOrigin {
  // Anunciante pagou a taxa de publicacao.
  PAID_CHARGE
  // Vigencia concedida no periodo de lancamento, sem cobranca.
  LAUNCH_COURTESY
  // Cortesia concedida manualmente pelo admin (negociacao, suporte).
  ADMIN_GRANT
}

enum PublicationOrderStatus {
  PENDING_PAYMENT
  PAID
  // Venceu sem pagamento. NAO e terminal: pagar depois do vencimento e fluxo
  // normal no Asaas (PAYMENT_OVERDUE -> PAYMENT_RECEIVED), entao a ativacao
  // precisa aceitar a volta deste estado.
  EXPIRED_UNPAID
  // Chargeback aberto. Tambem reversivel: disputa ganha devolve a cobranca
  // para confirmada e o anuncio precisa voltar ao ar.
  CHARGEBACK_OPEN
  REFUNDED
  CANCELED
}

enum AsaasBillingType {
  PIX
  CREDIT_CARD
}

// Pedido de publicacao: o que autoriza um anuncio a ficar no ar e por quanto
// tempo. Separado da cobranca porque um mesmo pedido pode ter varias tentativas
// (gera Pix, abandona, volta e paga no cartao) e porque quem libera a
// publicacao e o pedido, nao a transacao.
model PublicationOrder {
  id        String @id @default(cuid())
  // Nulaveis de proposito: excluir anuncio ou clinica nao pode apagar historico
  // financeiro. Os snapshots abaixo mantem o registro legivel depois disso.
  listingId String?  @map("listing_id")
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  clinicId  String?  @map("clinic_id")
  clinic    Clinic?  @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  listingTitle String @map("listing_title")
  clinicName   String @map("clinic_name")

  origin PublicationOrigin      @default(PAID_CHARGE)
  status PublicationOrderStatus @default(PENDING_PAYMENT)

  // Snapshot do preco no momento da criacao. E o que permite a cliente mudar
  // o valor da taxa depois sem reescrever historico nem afetar pedidos ja
  // emitidos.
  amountCents  Int    @map("amount_cents")
  durationDays Int    @map("duration_days")
  priceVersion String @map("price_version")

  createdAt  DateTime  @default(now()) @map("created_at")
  // Primeiro evento entre PAYMENT_CONFIRMED e PAYMENT_RECEIVED. Pix pula o
  // CONFIRMED e vai direto para RECEIVED, entao esperar so pelo CONFIRMED
  // deixaria todo pagador de Pix fora do ar.
  paidAt     DateTime? @map("paid_at")
  // Liquidacao financeira (PAYMENT_RECEIVED). So para conciliacao: no cartao
  // isso chega ate 32 dias depois da confirmacao.
  settledAt  DateTime? @map("settled_at")
  startsAt   DateTime? @map("starts_at")
  expiresAt  DateTime? @map("expires_at")
  canceledAt DateTime? @map("canceled_at")
  refundedAt DateTime? @map("refunded_at")
  // Ultimo aviso de vencimento enviado, para nao reenviar o mesmo lembrete.
  expiryWarnedAt DateTime? @map("expiry_warned_at")

  charges AsaasCharge[]

  @@index([listingId])
  @@index([clinicId])
  @@index([status])
  @@index([expiresAt])
  @@map("publication_orders")
}

// Tentativa de cobranca no Asaas. Espelha o estado do lado do gateway.
model AsaasCharge {
  id      String           @id @default(cuid())
  orderId String           @map("order_id")
  order   PublicationOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  asaasPaymentId String           @unique @map("asaas_payment_id")
  billingType    AsaasBillingType @map("billing_type")
  valueCents     Int              @map("value_cents")
  // Status cru do Asaas (PENDING, CONFIRMED, RECEIVED, OVERDUE, REFUNDED,
  // RECEIVED_IN_CASH, AWAITING_RISK_ANALYSIS...). Guardado como texto para nao
  // quebrar quando o gateway introduzir um valor novo.
  status         String

  invoiceUrl String? @map("invoice_url")
  // Copia e cola do Pix e validade vinda do proprio endpoint de QR Code. A
  // validade nao e calculada aqui de proposito: sem chave Pix cadastrada o QR
  // expira as 23:59 do mesmo dia, com chave dura 12 meses, e esse
  // comportamento muda conforme a conta.
  pixPayload   String?   @map("pix_payload") @db.Text
  pixExpiresAt DateTime? @map("pix_expires_at")

  dueDate   DateTime @map("due_date")
  raw       Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("asaas_charges")
}

// Evento bruto recebido do webhook do Asaas.
//
// A entrega e "pelo menos uma vez" e o payload NAO e assinado, entao o id do
// evento e a unica chave de deduplicacao que o gateway oferece. Guardar o
// evento tambem permite reprocessar o que falhou: 15 falhas consecutivas
// interrompem a fila inteira do Asaas e os eventos so ficam 14 dias la.
model AsaasWebhookEvent {
  id      String @id @default(cuid())
  eventId String @unique @map("event_id")
  event   String
  // Cobranca referenciada, quando houver. A conta recebe evento de qualquer
  // entrada de valor, inclusive Pix e transferencias que nao vieram da
  // plataforma, entao nem todo evento tem cobranca nossa correspondente.
  paymentId String? @map("payment_id")
  payload   Json

  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")
  error       String?

  @@index([processedAt])
  @@index([paymentId])
  @@map("asaas_webhook_events")
}
