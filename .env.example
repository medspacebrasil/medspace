# Database (Supabase)
DATABASE_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"

# Auth.js
AUTH_SECRET="gerar-com-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxx"
SUPABASE_SERVICE_ROLE_KEY="xxxx"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_DEFAULT_MESSAGE="Ola, vi seu anuncio no MedSpace e tenho interesse!"

# Meta Pixel (Facebook/Instagram Ads) — ID do "conjunto de dados" do Gerenciador
# de Eventos. Se ficar em branco, o Pixel nao carrega (o codigo fica inerte).
# So carrega no navegador apos o usuario aceitar cookies de marketing (LGPD).
# O Google Ads (conversoes AW-) ja esta no codigo, nao precisa de env var.
NEXT_PUBLIC_FB_PIXEL_ID=""

# Rate limiting (Upstash Redis) — protege login/cadastro contra brute-force.
# Crie um banco gratuito em https://console.upstash.com e copie as credenciais REST.
# Se ficar em branco, o rate limiting fica DESATIVADO (apenas para dev/pre-lancamento).
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxx"

# E-mail transacional (SMTP Hostinger) — usado na recuperacao de senha.
# Use a caixa contato@ ja criada na Hostinger. Se ficar em branco, o e-mail
# nao e enviado (o fluxo existe, mas o link nao chega).
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="contato@medspacebrasil.com.br"
SMTP_PASS="senha-da-caixa-contato"
EMAIL_FROM="MedSpace <contato@medspacebrasil.com.br>"

# Asaas (cobranca por publicacao)
# Chave de API gerada em Integracoes > Chaves de API. Sem permissao de saque.
# ATENCAO: a chave comeca com $aact_ e o Next expande $VAR ao carregar o .env,
# o que deixaria a chave VAZIA em dev. Escape o cifrao: ASAAS_API_KEY="\$aact_..."
# (aspas simples NAO protegem). Na Vercel nao ha esse parse; cole o valor puro.
ASAAS_API_KEY=
# sandbox | production
ASAAS_ENV=sandbox
# Token definido por nos e colado no cadastro do webhook (Integracoes > Webhooks).
# Chega no header asaas-access-token; gere com: openssl rand -hex 32
ASAAS_WEBHOOK_TOKEN=

# Varredura diaria (Vercel Cron). A Vercel envia este valor em Authorization: Bearer.
# Sem ele a rota /api/cron/expire-listings responde 401 e nenhum anuncio expira.
# Gere com: openssl rand -hex 32
CRON_SECRET=

# Sal do hash de visitante das metricas por anuncio. Se faltar, cai no AUTH_SECRET
# com aviso em producao; rotacionar o AUTH_SECRET zeraria a deduplicacao.
METRICS_HASH_SALT=

# Chave geral da cobranca por publicacao. Desligada (padrao), a moderacao
# publica direto. Ligue ("true") SO depois de: preco real em pricing.ts,
# pagina /planos atualizada e chave de producao do Asaas configurada.
BILLING_ENABLED=
